# Mẫu cấu hình — copy thành .env rồi điền giá trị. KHÔNG commit .env.
# Chỉ cần key của provider sẽ dùng; thiếu key provider nào thì provider đó báo "not configured".

# Anthropic Claude (default: Claude Sonnet 4.6)
ANTHROPIC_API_KEY=

# OpenAI (Responses API)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama local. Đặt theo nơi BACKEND chạy:
#   backend trong Docker (docker compose):  http://host.docker.internal:11434   (mặc định trong compose)
#   backend chạy thẳng trên Windows:        http://localhost:11434              (mặc định trong code)
#   backend trong WSL2, networking mirrored: http://localhost:11434
#   backend trong WSL2, NAT (mặc định):      http://<IP Windows host>:11434, và Ollama phải chạy với OLLAMA_HOST=0.0.0.0
# OLLAMA_BASE_URL=

# Tùy chọn
# MAX_ITERATIONS=5        # số lần CHẠY CODE tối đa (model được gọi tối đa thêm 1 lần để xác nhận DONE)
# EXECUTION_TIMEOUT=30    # giây cho mỗi lần chạy code
# MAX_OUTPUT_TOKENS=      # ghi đè max output tokens cho MỌI model (mặc định theo model_catalog.py)

# Truy cập. Server chạy code do model sinh ra và KHÔNG có auth: giữ mặc định là chỉ máy này.
# BIND_ADDRESS=127.0.0.1  # docker compose: địa chỉ publish port 8000. 0.0.0.0 = cả mạng LAN (tự chịu rủi ro)
# HOST_PORT=8000          # docker compose: cổng publish trên máy host (đổi nếu 8000 đang bị chiếm)
# HOST=127.0.0.1          # python server.py: địa chỉ nghe (lưu ý: python server.py không tự đọc file .env)
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173   # origin trình duyệt được gọi API (Vite dev)
