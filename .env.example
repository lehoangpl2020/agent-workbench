# Configuration template — copy it to .env, then fill in the values. Do NOT commit .env.
# You only need the key of the provider you will use; a provider without a key reports "not configured".

# Anthropic Claude (optional; the app default is local Ollama, qwen3.5:4b)
ANTHROPIC_API_KEY=

# OpenAI (Responses API)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Local Ollama. Set this according to where the BACKEND runs:
#   backend in Docker (docker compose):   http://host.docker.internal:11434   (default in compose)
#   backend running directly on Windows:  http://localhost:11434              (default in code)
#   backend in WSL2, mirrored networking:   http://localhost:11434
#   backend in WSL2, NAT (default):        http://<Windows host IP>:11434, and Ollama must run with OLLAMA_HOST=0.0.0.0
# OLLAMA_BASE_URL=

# Optional
# MAX_ITERATIONS=5        # max number of CODE RUNS (the model may be called once more to confirm DONE)
# EXECUTION_TIMEOUT=30    # seconds per code run
# MAX_OUTPUT_TOKENS=      # override max output tokens for EVERY model (default: per model in model_catalog.py)

# Access. The server runs code written by a model and has NO auth: keep the default (this machine only).
# BIND_ADDRESS=127.0.0.1  # docker compose: address to publish port 8668 on. 0.0.0.0 = the whole LAN (at your own risk)
# HOST_PORT=8668          # docker compose: port published on the host (change it if 8668 is taken)
# HOST=127.0.0.1          # python server.py: address to listen on (note: python server.py does not read .env by itself)
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173   # browser origins allowed to call the API (Vite dev)
