# Configuration template — copy it to .env, then fill in the values. Do NOT commit .env.
# You only need the key of the provider you will use; a provider without a key reports "not configured".

# Anthropic Claude (optional; the app default is local Ollama, qwen3.5:4b)
ANTHROPIC_API_KEY=

# OpenAI (Responses API)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Image tool (OpenAI image model, billed per image; needs OPENAI_API_KEY above). IMAGE_TOOL=true only makes the
# "Image tool" checkbox available in the UI; each run still has to tick it, and it is unticked by default.
# The code the agent writes calls the server for a picture; the key never enters the sandbox.
# Image calls take 20-120 s: ticking the box raises the UI's execution timeout to 120 s (the default is 30 s).
# Not available with ephemeral sandbox containers (they have no network); Compose uses the persistent sandbox.
# IMAGE_TOOL=true
# IMAGE_MODEL=gpt-image-1-mini   # cheapest on OpenAI's list, but OpenAI shuts it down on 2026-12-01. After that use
#                                # gpt-image-2.5-flare (or another model that GET /v1/models shows for your key).
#                                # OpenAI retires image models fast: gpt-image-1 already stopped on 2026-10-23.
# IMAGE_MAX_PER_RUN=4
# IMAGE_TOOL_URL=            # the server as the SANDBOX reaches it; default http://127.0.0.1:<PORT>, Compose sets it

# Local Ollama. Set this according to where the BACKEND runs:
#   backend in Docker (docker compose):   http://host.docker.internal:11434   (default in compose)
#   backend running directly on Windows:  http://localhost:11434              (default in code)
#   backend in WSL2, mirrored networking:   http://localhost:11434
#   backend in WSL2, NAT (default):        http://<Windows host IP>:11434, and Ollama must run with OLLAMA_HOST=0.0.0.0
# OLLAMA_BASE_URL=

# Optional
# MAX_ITERATIONS=5        # max number of CODE RUNS (the model may be called once more to confirm DONE)
# EXECUTION_TIMEOUT=30    # seconds per code run
# MAX_OUTPUT_TOKENS=      # override max output tokens for EVERY model (default: per model in model_catalog.py)

# Cost estimate per run. The code has NO prices: fill them in from the provider's current price list.
# One line of JSON in single quotes; keys are "provider/model" as in model_catalog.py; unit is USD per 1M tokens.
# "cache_read" and "cache_write" are optional (without them cache tokens are priced like input). A model with no entry
# gets tokens and time only. For a free local Ollama model use {"input": 0, "output": 0} to show $0.
# The numbers below only show the FORMAT; check them against the real price list before trusting a total.
# MODEL_PRICING='{"anthropic/claude-sonnet-4-6": {"input": 3, "output": 15}, "ollama/qwen3.5:4b": {"input": 0, "output": 0}}'
# (python server.py also accepts the path of a JSON file; with docker compose use the JSON itself.)

# Access. The server runs code written by a model and has NO auth: keep the default (this machine only).
# BIND_ADDRESS=127.0.0.1  # docker compose: address to publish port 8668 on. 0.0.0.0 = the whole LAN (at your own risk)
# HOST_PORT=8668          # docker compose: port published on the host (change it if 8668 is taken)
# HOST=127.0.0.1          # python server.py: address to listen on (note: python server.py does not read .env by itself)
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173   # browser origins allowed to call the API (Vite dev)
