FROM python:3.11-slim

# Install common data science + utility packages (khớp danh sách trong SYSTEM_PROMPT)
RUN pip install --no-cache-dir \
    numpy \
    pandas \
    matplotlib \
    seaborn \
    scipy \
    scikit-learn \
    requests \
    beautifulsoup4 \
    openpyxl \
    xlsxwriter \
    Pillow \
    sympy \
    tabulate \
    plotly

# Không có màn hình → matplotlib dùng backend Agg
ENV MPLBACKEND=Agg

# Create non-root user
RUN useradd -m -s /bin/bash -u 1000 sandbox

# /workspace/runs/<run_id>/ là volume chung với server (xem docker-compose.yml).
# /workspace/output được executor trỏ (symlink) vào output/ của run đang chạy.
RUN mkdir -p /workspace/runs && chown -R sandbox:sandbox /workspace

USER sandbox
WORKDIR /workspace

# No CMD — command passed at runtime
