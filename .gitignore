# Agent Workbench — generated at build/run time, not committed

# Frontend
web/node_modules/
web/dist/
*.tsbuildinfo

# UI build copied into the server (the Dockerfile rebuilds it)
static/

# Runtime data: SQLite history + artifacts of each run (data/db/ also holds migration backups)
data/

# SQLite files, in case one ends up outside data/
*.db
*.db-wal
*.db-shm
*.db-journal
*.db.bak*

# Python
.venv/
__pycache__/
.pytest_cache/

# Secrets
.env
.env.*

# OS / zip / editor junk
.DS_Store
__MACOSX/
Thumbs.db
.vscode/
.idea/

# Log
*.log

# Secrets: only .env.example is committed
!.env.example

# Local-only Vietnamese study notes (kept on disk, not published)
/docs/vi/
